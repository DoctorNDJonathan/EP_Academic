{
  "manifest_version": 3,
  "name": "Exam Proctor",
  "version": "3.0.0",
  "description": "Checks that you stay on the sites your instructor allows during an exam you have joined, only between its start and end time.",
  "permissions": ["tabs", "idle", "alarms", "storage", "notifications"],
  "host_permissions": ["https://SERVER_HOST_PLACEHOLDER/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exam Proctor",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
