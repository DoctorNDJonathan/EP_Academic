# Caddy gets and renews a free HTTPS certificate automatically (Let's Encrypt).
# Replace proctor.example.edu with your real domain.
proctor.example.edu {
	encode gzip

	request_body {
		max_size 2MB
	}

	# Optional: allow the dashboard and admin API only from campus / VPN addresses.
	# Students' extension endpoints (/api/join, /api/ingest, /api/exams/*, /bye) stay public.
	# @adminOutside {
	# 	path /dashboard /static/* /api/admin/* /api/auth/*
	# 	not remote_ip 203.0.113.0/24
	# }
	# respond @adminOutside "Not found" 404

	@app path /api/* /dashboard /privacy /static/* /bye /
	handle @app {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond "Not found" 404
	}

	header Strict-Transport-Security "max-age=31536000"

	log {
		output file /var/log/caddy/proctor-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
