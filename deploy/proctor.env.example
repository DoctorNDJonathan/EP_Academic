# Copy to /etc/proctor.env and restrict it:  sudo chmod 600 /etc/proctor.env
# Generate the secret once with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it later invalidates exam PINs, student sessions and admin sign-ins (passwords still work).
PROCTOR_SECRET=replace-with-64-hex-characters
PROCTOR_ENV=production
PROCTOR_DB=/opt/proctor/data/proctor.db
